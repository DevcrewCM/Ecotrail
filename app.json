{
  "expo": {
    "name": "Ecotrail",
    "slug": "Ecotrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Ecotrail to access your device motion."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ecotrail to use your location."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ecotrail to access your camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ecotrail to access your photos.",
          "savePhotosPermission": "Allow Ecotrail to save photos."
        }
      ]
    ]
  }
}
